# The IREE session shim (native/iree-session, MIT): generic IREE sessions over the Torq-fork runtime. The header is
# self-contained; the archives (libskainet_iree.a, libiree_torq_runtime.a) are linked into the shared library only,
# by build.gradle.kts, from build-native.sh's output.
headers = skainet_iree.h
package = sk.ainet.cartridge.runtime.lfm2.torq.native

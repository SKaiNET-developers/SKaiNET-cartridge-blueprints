{
  "spec_version": "0.4",
  "kind": "blueprint",
  "id": "detection-yolov8-iree",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Single-shot object detection: YOLOv8n (COCO, 80 classes, 640x640) on IREE, Vulkan or CPU. One self-compiled SKaiNET-DSL graph from image tensor to the decoded head; letterboxing, NMS and mapping back to the source image run in the Kotlin adapter behind the yolo/v1 task profile.",
  "descriptor_template": {
    "family": "yolov8",
    "execution_mode": "native",
    "model": {
      "name": "yolov8n",
      "variant": "iree-fp32",
      "params": 3200000,
      "checkpoint": "Ultralytics/YOLOv8 yolov8n.pt",
      "upstream": {
        "source": "https://huggingface.co/Ultralytics/YOLOv8",
        "license": "AGPL-3.0-only"
      }
    },
    "modality": "image",
    "task": "detection",
    "io": {
      "mode": "batch",
      "input": {
        "dtype": "float32",
        "shape": [
          1,
          3,
          640,
          640
        ]
      },
      "output": {
        "dtype": "float32",
        "shape": [
          1,
          84,
          8400
        ]
      }
    },
    "attributes": {
      "task_profile": "yolo/v1",
      "label_set": [
        "person",
        "bicycle",
        "car",
        "motorcycle",
        "airplane",
        "bus",
        "train",
        "truck",
        "boat",
        "traffic light",
        "fire hydrant",
        "stop sign",
        "parking meter",
        "bench",
        "bird",
        "cat",
        "dog",
        "horse",
        "sheep",
        "cow",
        "elephant",
        "bear",
        "zebra",
        "giraffe",
        "backpack",
        "umbrella",
        "handbag",
        "tie",
        "suitcase",
        "frisbee",
        "skis",
        "snowboard",
        "sports ball",
        "kite",
        "baseball bat",
        "baseball glove",
        "skateboard",
        "surfboard",
        "tennis racket",
        "bottle",
        "wine glass",
        "cup",
        "fork",
        "knife",
        "spoon",
        "bowl",
        "banana",
        "apple",
        "sandwich",
        "orange",
        "broccoli",
        "carrot",
        "hot dog",
        "pizza",
        "donut",
        "cake",
        "chair",
        "couch",
        "potted plant",
        "bed",
        "dining table",
        "toilet",
        "tv",
        "laptop",
        "mouse",
        "remote",
        "keyboard",
        "cell phone",
        "microwave",
        "oven",
        "toaster",
        "sink",
        "refrigerator",
        "book",
        "clock",
        "vase",
        "scissors",
        "teddy bear",
        "hair drier",
        "toothbrush"
      ],
      "input_resolution": 640,
      "input_layout": "NCHW, RGB, values in [0, 1], letterboxed with pad value 114/255",
      "output_layout": "[1, 4 + classes, anchors]: rows 0-3 box center x, center y, width, height in input pixels; rows 4.. per-class sigmoid scores; anchors over strides 8, 16, 32",
      "conf_threshold": 0.25,
      "iou_threshold": 0.45,
      "max_detections": 300,
      "nms": "adapter, class-aware",
      "weights": "fp32",
      "runtime_hint": {
        "runtime": "iree",
        "version": "3.11.0",
        "contract": "single-shot module: one function, one input tensor, one output tensor (generic IREE module runner)"
      }
    }
  },
  "sources": [
    {
      "name": "weights",
      "role": "weights",
      "uri": "hf://Ultralytics/YOLOv8",
      "revision": "27f858f2dc238503a66ce10248cf7ec71a3ded5d",
      "files": [
        {
          "path": "yolov8n.pt",
          "digest": "sha256:31e20dde3def09e2cf938c7be6fe23d9150bbbe503982af13345706515f2ef95",
          "size": 6534387
        }
      ],
      "license": "AGPL-3.0-only",
      "license_url": "https://huggingface.co/Ultralytics/YOLOv8/blob/27f858f2dc238503a66ce10248cf7ec71a3ded5d/README.md",
      "redistribution": "restricted"
    }
  ],
  "toolchain": {
    "ultralytics": {
      "version": "8.4.170",
      "image": "ultralytics/ultralytics:8.4.170-cpu@sha256:03cbc1eaf0c0f089b46e59b5fc1d5064aa84e2bf89c26a52ea4724db069e047f",
      "description": "convert only: yolov8n.pt (PyTorch pickle) -> ONNX, the format the SKaiNET weight loader reads. Never shipped."
    },
    "skainet": {
      "version": "0.60.1",
      "coordinates": "sk.ainet:skainet-bom",
      "description": "SKaiNET DSL, StableHLO export, Letterbox and NMS (skainet-data-media)"
    },
    "iree-tools": {
      "version": "3.11.0",
      "image": "skainet/iree-compiler:3.11.0",
      "description": "IREE tools (StableHLO -> IREE): iree-compile with parameter export"
    },
    "iree-android-runtime": {
      "version": "0.61.1",
      "coordinates": "sk.ainet.transformers:skainet-transformers-runtime-iree-android",
      "description": "libskainet_iree_module.so + IreeModuleRunner (generic single-shot module runner), built and published by SKaiNET-transformers"
    },
    "blueprint-plugin": {
      "version": "0.1.0",
      "coordinates": "sk.ainet.cartridge.blueprint"
    }
  },
  "targets": [
    {
      "id": "vulkan-arm64",
      "target": {
        "hardware": "IREE-arm64-v8a",
        "abi": "arm64-v8a",
        "accelerator": "Vulkan GPU (valhall4)"
      },
      "requirements": {
        "needs_accelerator": true,
        "memory_mb": 512,
        "os": {
          "name": "android",
          "min_api": 29
        }
      },
      "params": {
        "backend": "vulkan",
        "iree_target": "valhall4",
        "device": "vulkan"
      }
    },
    {
      "id": "cpu-arm64",
      "target": {
        "hardware": "IREE-arm64-v8a",
        "abi": "arm64-v8a"
      },
      "requirements": {
        "needs_accelerator": false,
        "memory_mb": 512,
        "os": {
          "name": "android",
          "min_api": 29
        }
      },
      "params": {
        "backend": "cpu",
        "iree_target": "arm64",
        "device": "local-task"
      }
    }
  ],
  "steps": [
    {
      "id": "fetch",
      "kind": "fetch",
      "tool": "blueprint-plugin",
      "uses": [
        "weights"
      ],
      "produces": [
        "weights-files"
      ],
      "description": "SKaiNET data-source: hf:// at the pinned revision, SHA-256 verified."
    },
    {
      "id": "convert",
      "kind": "convert",
      "tool": "ultralytics",
      "uses": [
        "weights-files"
      ],
      "produces": [
        "yolov8n-onnx"
      ],
      "description": "yolo export format=onnx imgsz=640 opset=17 in the pinned container (plus onnx==1.23.2, which the CPU image lacks): the PyTorch checkpoint as ONNX initializers, Conv+BN fused by the exporter. Only the 127 initializers are read downstream; the graph is SKaiNET's. The file's bytes are not reproducible (the exporter stamps a date into the metadata); the initializers are.",
      "params": {
        "imgsz": 640,
        "opset": 17,
        "onnx": "1.23.2"
      }
    },
    {
      "id": "export",
      "kind": "export",
      "tool": "skainet",
      "uses": [
        "yolov8n-onnx"
      ],
      "produces": [
        "yolov8n-mlir"
      ],
      "description": "Kotlin (YoloV8ExportCli, this blueprint): ONNX initializers -> the SKaiNET YoloV8 graph (src/commonMain/.../model/YoloV8.kt) with in-graph DFL decode -> StableHLO, one function image[1,3,640,640] -> head[1,84,8400], weights folded."
    },
    {
      "id": "parameters",
      "kind": "convert",
      "tool": "iree-tools",
      "uses": [
        "yolov8n-mlir"
      ],
      "produces": [
        "params-irpa"
      ],
      "description": "iree-compile --iree-opt-export-parameters=model=params.irpa: the weights as one target-independent parameter archive."
    },
    {
      "id": "compile",
      "kind": "compile",
      "tool": "iree-tools",
      "uses": [
        "yolov8n-mlir"
      ],
      "produces": [
        "yolov8n-vmfb"
      ],
      "per_target": true,
      "description": "StableHLO -> .vmfb for the target, referencing the parameter archive under scope `model`."
    },
    {
      "id": "build-runtime",
      "kind": "build-runtime",
      "tool": "iree-android-runtime",
      "produces": [
        "runtime-so"
      ],
      "per_target": true,
      "description": "libskainet_iree_module.so for the target ABI, taken from the released SKaiNET-transformers Android runtime AAR."
    },
    {
      "id": "pack",
      "kind": "pack",
      "tool": "blueprint-plugin",
      "uses": [
        "runtime-so",
        "yolov8n-vmfb",
        "params-irpa"
      ],
      "produces": [
        "pack-dir"
      ],
      "description": "descriptor.json + manifest.json + artifacts/<role>/... (cartridge spec pack_dir)."
    },
    {
      "id": "sign",
      "kind": "sign",
      "tool": "blueprint-plugin",
      "uses": [
        "pack-dir"
      ],
      "produces": [
        "manifest"
      ],
      "description": "Ed25519 over the canonical manifest, key from the profile."
    }
  ],
  "outputs": [
    {
      "from": "runtime-so",
      "role": "runtime",
      "path": "artifacts/runtime/libskainet_iree_module.so",
      "derived_from": []
    },
    {
      "from": "yolov8n-vmfb",
      "role": "model",
      "path": "artifacts/model/yolov8n.vmfb",
      "derived_from": [
        "weights"
      ]
    },
    {
      "from": "params-irpa",
      "role": "weights",
      "path": "artifacts/weights/params.irpa",
      "derived_from": [
        "weights"
      ]
    }
  ],
  "verification": [
    {
      "id": "host-parity",
      "kind": "parity",
      "tolerance": 0.01,
      "on_device": false,
      "description": "Head tensor vs ONNX Runtime on the converted model (relative tolerance); identical boxes after NMS."
    },
    {
      "id": "device-golden",
      "kind": "golden",
      "tolerance": 0.9,
      "on_device": true,
      "description": "Fixture images: expected classes, box IoU at least the tolerance vs the host reference."
    }
  ]
}

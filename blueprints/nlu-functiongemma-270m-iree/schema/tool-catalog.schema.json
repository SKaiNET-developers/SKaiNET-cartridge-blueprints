{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SKaiNET-developers/SKaiNET-cartridge-blueprints/blueprints/nlu-functiongemma-270m-iree/schema/tool-catalog.schema.json",
  "title": "Tool catalog for the FunctionGemma NLU cartridge",
  "description": "The functions the model may call. Rendered into the prompt prefix exactly as given: names and descriptions are model input, so wording matters. The catalog is a materialization input — it is packed into the cartridge as artifacts/other/tool-catalog.json and never part of the blueprint.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "functions"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Name and version of the catalog, reported in the descriptor (attributes.tool_catalog).",
      "pattern": "^[a-z0-9][a-z0-9.-]*$",
      "examples": ["toy-tools.v1"]
    },
    "languages": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Languages the descriptions were written for; reported as attributes.languages."
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "description": { "type": "string", "minLength": 1 },
          "parameters": {
            "type": "object",
            "description": "Argument name → definition. All arguments are strings on the wire.",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "description"],
              "properties": {
                "type": { "type": "string", "enum": ["string", "number", "integer", "boolean"] },
                "description": { "type": "string" },
                "enum": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
              }
            }
          },
          "required": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}

{
  "spec_version": "0.4",
  "kind": "blueprint",
  "id": "generator-lfm25-350m-torq",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Text generation with LFM2.5-350M on the Synaptics Torq NPU: one single-token decode step per call, for every position up to a fixed capacity, exported from the SKaiNET DSL with Q8_0 projections and a Q4_0 output head kept packed as block-quant matmuls, the whole graph bf16, compiled with the Torq 2.3.0 compiler to one NPU dispatch. Embedding lookup, RoPE, masks, sampling and stopping run on the host (this module's Kotlin API).",
  "descriptor_template": {
    "family": "lfm2-hybrid",
    "execution_mode": "native",
    "modality": "text",
    "task": "generation",
    "model": {
      "name": "lfm2.5-350m",
      "variant": "torq-bf16-q8_0-head-q4_0-cached64",
      "params": 354000000,
      "checkpoint": "LiquidAI/LFM2.5-350M",
      "upstream": {
        "source": "https://huggingface.co/LiquidAI/LFM2.5-350M",
        "license": "LicenseRef-LFM-Open-License-1.0"
      }
    },
    "io": {
      "mode": "streaming",
      "input": {
        "dtype": "int32-token-ids",
        "shape": [
          null
        ]
      },
      "output": {
        "dtype": "int32-token-ids",
        "shape": [
          null
        ]
      }
    },
    "attributes": {
      "state_model": "session",
      "context_tokens": 64,
      "weights": "Q8_0 projections, Q4_0 output head (block-quant, packed), bf16 activations",
      "runtime_hint": {
        "runtime": "iree",
        "version": "Torq-fork 2.3.0",
        "contract": "lfm2-decode-step-v1 (embedded row, cos/sin, additive mask [1, C+1], one-hot write mask [1, C, 1], conv histories and K/V as state in and out; argument order in artifacts/model/io.txt; host-side bf16 embedding rows)"
      }
    }
  },
  "sources": [

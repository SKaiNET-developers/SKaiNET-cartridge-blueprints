      "redistribution": "allowed"
    }
  ],
  "toolchain": {
    "blueprint-plugin": {
      "version": "0.1.0",
      "coordinates": "sk.ainet.cartridge.blueprint"
    },
    "skainet-transformers": {
      "version": "0.64.2",
      "coordinates": "sk.ainet.transformers:skainet-transformers-inference-lfm2",
      "description": "Lfm2DecodeStepExportCli: verified local checkpoint -> decode_step.mlir (packed block-quant matmuls), io.txt, embed.bf16.bin, export.json (Kotlin)"
    },
    "iree-tools-torq": {
      "version": "2.3.0",
      "image": "skainet/iree-compiler-torq:2.3.0",
      "description": "Synaptics Torq-fork iree-compile (SKaiNET-embedded-vendors synaptics-torq/docker): compile-torq with --input stablehlo-torq, which lowers the folded block-quant matmuls to Torq's mixed-quant kernel"
    },
    "iree-runtime-torq": {
      "version": "2.3.0",
      "image": "skainet/iree-runtime-torq:2.3.0",
      "description": "The Torq-fork IREE runtime (Torq v2.3.0 and the IREE commit it pins) built from source for linux-aarch64 with the Kotlin/Native clang and sysroot (SKaiNET-embedded-vendors synaptics-torq/docker-runtime, built locally with its build.sh). runtimes/lfm2-torq/native/build-native.sh runs in it: the runtime archive and license set, the vendored hes_iree shim, the embedded descriptor."
    },
    "kotlin-native": {
      "version": "2.4.21",
      "coordinates": "org.jetbrains.kotlin.multiplatform",
      "description": "Links runtimes/lfm2-torq (Cartridge Runtime ABI 0.1 over this module's GreedyDecoder) with those archives into liblfm2_torq_cartridge.so (linuxArm64 sharedLib)."
    }
  },
  "targets": [
    {
      "id": "torq-sl26xx",
      "cartridge_id": "generator-lfm25-350m-torq-sl26xx",
      "target": {
        "hardware": "IREE-linux-aarch64 (Synaptics SL26xx, Cortex-A55 + Torq NPU)",
        "abi": "linux-aarch64",
        "accelerator": "Synaptics Torq NPU (SL2610)"
      },
      "requirements": {
        "needs_accelerator": true,
        "memory_mb": 900,
        "driver": {
          "name": "Torq-fork IREE runtime",
          "min_version": ">=2.3.0 <2.4",
          "note": "the module comes from the Torq 2.3.0 compiler; it is one dispatch on the torq device, about 350 MB"
        },
        "os": {
          "name": "linux"
        }
      },
      "params": {
        "toolchain": "iree-tools-torq",
        "torq_hw": "SL2610",
        "capacity": "64",
        "weights": "q8_0",
        "head": "q4_0",
        "conv": "multiply-sum",
        "attention": "batched"
      }
    }
  ],
  "inputs": [],
  "steps": [
    {
      "id": "fetch",
      "kind": "fetch",
      "tool": "blueprint-plugin",
      "uses": [
        "weights"
      ],
      "produces": [
        "weights-files"
      ],
      "description": "SKaiNET data-source: hf:// at the pinned revision, SHA-256 verified, after the profile's license acceptance."
    },
    {
      "id": "export",
      "kind": "export",
      "tool": "skainet-transformers",
      "uses": [
        "weights-files"
      ],
      "produces": [
        "decode-step-mlir",
        "io-table",
        "embedding-rows",
        "export-manifest"
      ],
      "params": {
        "capacity": "params.capacity",
        "weights": "params.weights",
        "head": "params.head"
      },
      "description": "Lfm2DecodeStepExportCli: loads the checkpoint with the projections requantized (Q8_0), builds a Q4_0 copy of the tied embedding as the output head, traces the fixed-capacity decode step and folds every packed matmul (93 for LFM2.5-350M; any left unfolded fails the step). Writes the host's bf16 embedding rows."
    },
    {
      "id": "torq-bf16-retype",
      "kind": "convert",
      "tool": "blueprint-plugin",
      "uses": [
        "decode-step-mlir"
      ],
      "produces": [
        "decode-step-bf16-mlir"
      ],
      "description": "Every f32 type to bf16, arguments and results included (Torq's f32 host fallback returns NaN); the infinities become their bf16 bits, any other f32 hex constant fails the step."
    },
    {
      "id": "compile",
      "kind": "compile",
      "tool": "iree-tools-torq",
      "uses": [
        "decode-step-bf16-mlir"
      ],
      "produces": [
        "decode-step-vmfb"
      ],
      "per_target": true,
      "description": "compile-torq --input stablehlo-torq --target <params.torq_hw>: one torq dispatch with the weights inline."
    },
    {
      "id": "build-torq-runtime",
      "kind": "build-runtime",
      "tool": "iree-runtime-torq",
      "uses": [
        "torq-runtime-source",
        "iree-runtime-source"
      ],
      "produces": [
        "torq-native-archives",
        "torq-runtime-licenses"
      ],
      "description": "In skainet/iree-runtime-torq: copy the source-built Torq-fork IREE runtime archive, headers and license set; compile the vendored hes_iree shim (runtimes/lfm2-torq/native/hes, pinned in upstream.json) and the resolved descriptor's bytes for ctg_descriptor_json."
    },
    {
      "id": "build-native",
      "kind": "build-runtime",
      "tool": "kotlin-native",
      "uses": [
        "torq-native-archives"
      ],
      "produces": [
        "native-runtime"
      ],
      "description": "Kotlin/Native linuxArm64 shared library exporting the Cartridge Runtime ABI 0.1 (streaming: push prompt token ids, flush, pull one generated token per PARTIAL, then FINAL with all of them); the decode step runs in-process on the torq device, the runtime and shim linked statically."
    },
    {
      "id": "pack",
      "kind": "pack",
      "tool": "blueprint-plugin",
      "uses": [
        "decode-step-vmfb",
        "io-table",
        "embedding-rows",
        "export-manifest",
        "weights-files",
        "native-runtime",
        "torq-runtime-licenses"
      ],
      "produces": [
        "pack-dir"
      ],
      "description": "descriptor.json + manifest.json + artifacts/<role>/… (cartridge spec pack_dir)."
    },
    {
      "id": "sign",
      "kind": "sign",
      "tool": "blueprint-plugin",
      "uses": [
        "pack-dir"
      ],
      "produces": [
        "manifest"
      ],
      "description": "Ed25519 over the canonical manifest, key from the profile."
    }
  ],
  "outputs": [
    {
      "from": "native-runtime",
      "role": "runtime",
      "path": "artifacts/runtime/liblfm2_torq_cartridge.so",
      "derived_from": [
        "torq-runtime-source",
        "iree-runtime-source"
      ]
    },
    {
      "from": "decode-step-vmfb",
      "role": "model",
      "path": "artifacts/model/decode_step.vmfb",
      "derived_from": [
        "weights"
      ]
    },
    {
      "from": "io-table",
      "role": "model",
      "path": "artifacts/model/io.txt",
      "derived_from": []
    },
    {
      "from": "export-manifest",
      "role": "model",
      "path": "artifacts/model/export.json",
      "derived_from": [
        "weights"
      ]
    },
    {
      "from": "embedding-rows",
      "role": "weights",
      "path": "artifacts/weights/embed.bf16.bin",
      "derived_from": [
        "weights"
      ]
    },
    {
      "from": "tokenizer-tokenizer",
      "role": "tokenizer",
      "path": "artifacts/tokenizer/tokenizer.json",
      "derived_from": [
        "weights"
      ]
    },
    {
      "from": "tokenizer-tokenizer-config",
      "role": "tokenizer",
      "path": "artifacts/tokenizer/tokenizer_config.json",
      "derived_from": [
        "weights"
      ]
    },
    {
      "from": "tokenizer-chat-template",
      "role": "tokenizer",
      "path": "artifacts/tokenizer/chat_template.jinja",
      "derived_from": [
        "weights"
      ]
    },
    {
      "from": "tokenizer-generation-config",
      "role": "tokenizer",
      "path": "artifacts/tokenizer/generation_config.json",
      "derived_from": [
        "weights"
      ]
    },
    {
      "from": "tokenizer-config",
      "role": "tokenizer",
      "path": "artifacts/tokenizer/config.json",
      "derived_from": [
        "weights"
      ]
    },
    {
      "from": "model-license",
      "role": "other",
      "path": "artifacts/license/LICENSE",
      "derived_from": [
        "weights"
      ]
    },
    {
      "from": "torq-runtime-licenses",
      "role": "other",
      "path": "artifacts/runtime/licenses/",
      "derived_from": [
        "torq-runtime-source",
        "iree-runtime-source"
      ]
    }
  ],
  "reference_measurements": [
    {
      "target": "torq-sl26xx",
      "measured_on": "SL2610 board, Torq 2.3.0 runtime (astra-sl-torq-run-module), one decode step at position 5",
      "performance": {
        "decode_step_ms": 533,
        "module_load_ms": 274,
        "logits_cosine_to_fp32": 0.996,
        "note": "an expectation for whoever materializes, never copied into a descriptor"
      }
    }
  ]
}

        {
          "path": "tokenizer_config.json",
          "digest": "sha256:3701f370c70034d06e28947ff51c1063983393319f429e3ce58f06a45fae67cc",
          "size": 595
        },
        {
          "path": "chat_template.jinja",
          "digest": "sha256:ba551d58630afa3190b1be3602e28301f3d2e9bbac978dfc49d6d825171648b6",
          "size": 5487
        },
        {
          "path": "tokenizer.json",
          "digest": "sha256:df1d8d5ec5d091b460562ffd545e4a5e91d17d4a0db7ebe733be34ed374377bd",
          "size": 4733389
        },
        {
          "path": "LICENSE",
          "digest": "sha256:4d28ca14dedc0b3d0fcc2b3339f0e79931faa33874f3d24f522183a8fc70068c",
          "size": 10574
        }
      ],
      "license": "LicenseRef-LFM-Open-License-1.0",

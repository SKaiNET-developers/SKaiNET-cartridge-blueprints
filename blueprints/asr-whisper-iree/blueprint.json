        "abi": "arm64-v8a"
      },
      "requirements": {
        "needs_accelerator": false,
        "memory_mb": 1024,
        "os": {
          "name": "android",
          "min_api": 29
        }
      },
      "params": {
        "backend": "cpu",
        "iree_target": "arm64",
        "device": "local-task",
        "decoder_iree_target": "arm64",
        "decoder_device": "local-task"

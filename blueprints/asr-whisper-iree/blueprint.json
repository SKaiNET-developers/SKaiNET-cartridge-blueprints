    }
  ],
  "toolchain": {
    "skainet": {
      "version": "0.62.0",
      "coordinates": "sk.ainet:skainet-bom"
    },
    "skainet-transformers": {
      "version": "0.63.0",
      "coordinates": "sk.ainet.transformers:skainet-transformers-inference-whisper",
      "description": "WhisperExportCli: Hugging Face snapshot -> three StableHLO graphs + one shared params.irpa + manifest.json (Kotlin)"
    },
    "iree-tools": {
      "version": "3.11.0",
      "image": "skainet/iree-compiler:3.11.0",
      "description": "IREE tools (StableHLO -> IREE): iree-compile with parameter export"
    },
    "iree-android-runtime": {
      "version": "0.63.0",
      "coordinates": "sk.ainet.transformers:skainet-transformers-runtime-iree-android",
      "description": "libskainet_whisper_session.so + IreeWhisperSession, built and published by SKaiNET-transformers from llm-runtime/iree-android/native"
    },
    "blueprint-plugin": {
      "version": "0.1.0",
      "coordinates": "sk.ainet.cartridge.blueprint"
    }
  },
  "targets": [
    {
      "id": "vulkan-armv7",
      "target": {
        "hardware": "IREE-armeabi-v7a",
        "abi": "armeabi-v7a",
        "accelerator": "Vulkan GPU (valhall4)"
      },
      "requirements": {
        "needs_accelerator": true,
        "memory_mb": 1024,
        "os": {
          "name": "android",
          "min_api": 29
        }
      },
      "params": {
        "backend": "vulkan",
        "iree_target": "valhall4",
        "device": "vulkan",
        "decoder_iree_target": "arm32",
        "decoder_device": "local-task"
      }
    },
    {

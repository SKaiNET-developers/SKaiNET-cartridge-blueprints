            "license": "Apache-2.0"
          }
        }
      }
    }
  ],
  "inputs": [],
  "steps": [
    {
      "id": "fetch",
      "kind": "fetch",
      "tool": "blueprint-plugin",
      "uses": [
        "weights-en",
        "weights-de"
      ],
      "produces": [
        "weights-en-files",
        "weights-de-files"
      ],
      "description": "SKaiNET data-source: hf:// at the pinned revision, SHA-256 verified. Only the selected flavors are fetched."
    },
    {
      "id": "export",
      "kind": "export",
      "tool": "skainet-transformers",
      "uses": [
        "weights-en-files",
        "weights-de-files"
      ],
      "produces": [
        "en-encoder-mlir",
        "en-prefill-mlir",
        "en-step-mlir",
        "de-encoder-mlir",
        "de-prefill-mlir",
        "de-step-mlir",
        "en-params",
        "de-params",
        "en-contract",
        "de-contract"
      ],
      "params": {
        "WHISPER_AUDIO_CTX": "200",
        "WHISPER_MAX_POSITIONS": "48"
      },
      "description": "Kotlin, no Python: WhisperExportCli traces encoder, prefill and step in one session, so prefill and step share their parameter keys; their weights go into one params.irpa (deduplicated, byte-identity asserted), the encoder keeps its weights inline. manifest.json pins function names and argument/result order."
    },
    {
      "id": "compile",
      "kind": "compile",
      "tool": "iree-tools",
      "uses": [
        "en-encoder-mlir",
        "en-prefill-mlir",
        "en-step-mlir",
        "de-encoder-mlir",
        "de-prefill-mlir",
        "de-step-mlir"
      ],
      "produces": [
        "en-encoder-vmfb",
        "en-prefill-vmfb",
        "en-step-vmfb",
        "de-encoder-vmfb",
        "de-prefill-vmfb",
        "de-step-vmfb"
      ],
      "per_target": true,
      "description": "iree-compile per target: the encoder for the target's backend (vulkan-spirv with --iree-vulkan-target, or llvm-cpu); prefill and step for the CPU of the target's ABI (llvm-cpu, `decoder_iree_target`) on every target — the step graph does not compile for Vulkan with IREE 3.11, and its M = 1 matrix-vector products cost about the same on both. Prefill and step keep their parameter references (scope `model`), resolved against params.irpa at load time."
    },
    {
      "id": "build-runtime",
      "kind": "build-runtime",
      "tool": "iree-android-runtime",
      "produces": [
        "runtime-so"
      ],
      "per_target": true,
      "description": "libskainet_whisper_session.so for the target ABI, taken from the released SKaiNET-transformers Android runtime AAR (built there from llm-runtime/iree-android/native)."
    },
    {
      "id": "pack",
      "kind": "pack",
      "tool": "blueprint-plugin",
      "description": "descriptor.json + manifest.json + artifacts/<role>/<language>/… (cartridge spec pack_dir).",
      "produces": [
        "pack-dir"
      ],
      "uses": [
        "en-encoder-vmfb",
        "en-prefill-vmfb",
        "en-step-vmfb",
        "de-encoder-vmfb",
        "de-prefill-vmfb",
        "de-step-vmfb",
        "en-params",
        "en-contract",
        "de-params",
        "de-contract",
        "en-tokenizer",
        "de-tokenizer",
        "runtime-so"
      ]
    },
    {
      "id": "sign",
      "kind": "sign",
      "tool": "blueprint-plugin",
      "description": "Ed25519 over the canonical manifest, key from the profile.",
      "produces": [
        "manifest"
      ],
      "uses": [
        "pack-dir"
      ]
    }
  ],
  "outputs": [
    {
      "from": "en-encoder-vmfb",
      "role": "model",
      "path": "artifacts/model/en/encoder.vmfb",

{
  "spec_version": "0.4",
  "kind": "blueprint",
  "id": "asr-whisper-iree",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Speech-to-text: Whisper tiny (English, German) on IREE, Vulkan or CPU, for short utterances. Three self-compiled SKaiNET-DSL graphs — encoder over a fixed 4 s window, masked prompt prefill, one KV-cache step per token — with one shared parameter archive; log-mel features and detokenization on the host.",
  "descriptor_template": {
    "family": "whisper",
    "execution_mode": "native",
    "model": {
      "name": "whisper-tiny",
      "variant": "iree-fp32-window4s",
      "params": 39000000,
      "checkpoint": "openai/whisper-tiny.en",
      "upstream": {
        "source": "https://huggingface.co/openai",
        "license": "Apache-2.0"
      }
    },
    "modality": "audio",
    "task": "asr",
    "io": {
      "mode": "batch",
      "input": {
        "dtype": "float32-pcm",
        "shape": [
          null
        ],
        "sample_rate_hz": 16000
      },
      "output": {
        "dtype": "utf8-text",
        "shape": [
          null
        ]
      }
    },
    "attributes": {
      "streaming": false,
      "languages": [],
      "state_model": "stateless",
      "max_utterance_s": 4.0,
      "audio_ctx": 200,
      "mel_bins": 80,
      "max_positions": 48,
      "weights": "fp32 (encoder inline, decoder from the shared parameter archive)",
      "frontend": "host: 80-bin log-mel of 16 kHz audio (Whisper's standard frontend: 25 ms window, 10 ms hop), padded or cut to 4 s",
      "runtime_hint": {
        "runtime": "iree",
        "version": "3.11.0",
        "contract": "whisper-v2 (encoder + masked prefill + KV step, the self/cross KV cache as explicit graph I/O, host-computed additive masks; one parameter archive shared by prefill and step; manifest.json names functions, argument and result order)"
      }
    }
  },

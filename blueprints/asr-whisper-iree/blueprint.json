        "os": {
          "name": "android",
          "min_api": 29
        }
      },
      "params": {
        "backend": "vulkan",
        "iree_target": "valhall4",
        "device": "vulkan",
        "decoder_iree_target": "arm64",
        "decoder_device": "local-task"
      }
    },
    {
      "id": "cpu-arm64",
      "target": {

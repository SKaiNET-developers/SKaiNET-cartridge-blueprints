      "redistribution": "allowed"
    }
  ],
  "toolchain": {
    "skainet": {
      "version": "0.56.0",
      "coordinates": "sk.ainet:skainet-bom"
    },
    "skainet-transformers": {
      "version": "0.56.1",
      "coordinates": "sk.ainet.transformers:skainet-transformers-inference-moonshine",
      "description": "MoonshineV2ExportCli: Hugging Face snapshot -> StableHLO graphs + tables (Kotlin)"
    },
    "iree-tools": {
      "version": "3.11.0",
      "image": "skainet/iree-compiler:3.11.0",
      "description": "IREE tools (StableHLO -> IREE): iree-compile with parameter export"
    },
    "iree-android-runtime": {
      "version": "0.56.2",
      "coordinates": "sk.ainet.transformers:skainet-transformers-runtime-iree-android",
      "description": "libskainet_moonshine_stream.so + IreeMoonshineStream, built and published by SKaiNET-transformers from llm-runtime/iree-android/native"
    },
    "blueprint-plugin": {
      "version": "0.1.0",
      "coordinates": "sk.ainet.cartridge.blueprint"
    }
  },
  "targets": [
    {
      "id": "vulkan-armv7",
      "target": {
        "hardware": "IREE-armeabi-v7a",
        "abi": "armeabi-v7a",
        "accelerator": "Vulkan GPU (valhall4)"
      },
      "requirements": {
        "needs_accelerator": true,
        "memory_mb": 1024,
        "os": {
          "name": "android",
          "min_api": 29
        }
      },
      "params": {
        "backend": "vulkan",
        "iree_target": "valhall4",
        "device": "vulkan"
      }
    },
    {
      "id": "cpu-armv7",
      "target": {
        "hardware": "IREE-armeabi-v7a",
        "abi": "armeabi-v7a"
      },
      "requirements": {
        "needs_accelerator": false,
        "memory_mb": 1024,
        "os": {
          "name": "android",
          "min_api": 29
        }
      },
      "params": {
        "backend": "cpu",
        "iree_target": "arm32",
        "device": "local-task"
      }
    },
    {
      "id": "vulkan-arm64",
      "target": {
        "hardware": "IREE-arm64-v8a",
        "abi": "arm64-v8a",
        "accelerator": "Vulkan GPU (valhall4)"
      },
      "requirements": {
        "needs_accelerator": true,
        "memory_mb": 1024,
        "os": {
          "name": "android",
          "min_api": 29
        }
      },
      "params": {
        "backend": "vulkan",
        "iree_target": "valhall4",
        "device": "vulkan"
      }
    },
    {
      "id": "cpu-arm64",
      "target": {
        "hardware": "IREE-arm64-v8a",
        "abi": "arm64-v8a"
      },
      "requirements": {
        "needs_accelerator": false,
        "memory_mb": 1024,
        "os": {
          "name": "android",
          "min_api": 29
        }
      },
      "params": {
        "backend": "cpu",
        "iree_target": "arm64",
        "device": "local-task"
      }
    }
  ],
  "flavors": [
    {
      "id": "en",
      "sources": [
        "weights-en"
      ],
      "descriptor_overrides": {
        "attributes": {
          "languages": [
            "en"
          ]
        },
        "model": {
          "name": "moonshine-streaming-tiny",
          "variant": "iree-fp32-streaming-en",
          "params": 27000000,
          "checkpoint": "moonshine-ai/moonshine-streaming-tiny"
        }
      }
    },
    {
      "id": "de",
      "sources": [
        "weights-de"
      ],
      "descriptor_overrides": {
        "attributes": {
          "languages": [
            "de"
          ]
        },
        "model": {
          "checkpoint": "moonshine-ai/moonshine-streaming-tiny-de",
          "name": "moonshine-streaming-tiny",
          "variant": "iree-fp32-streaming-de",
          "params": 27000000
        }
      }
    }
  ],
  "inputs": [],
  "steps": [
    {
      "id": "fetch",
      "kind": "fetch",
      "tool": "blueprint-plugin",
      "uses": [
        "weights-en",
        "weights-de"
      ],
      "produces": [
        "weights-en-files",
        "weights-de-files"
      ],
      "description": "SKaiNET data-source: hf:// at the pinned revision, SHA-256 verified. Only the selected flavors are fetched."
    },
    {
      "id": "export",
      "kind": "export",
      "tool": "skainet-transformers",
      "uses": [
        "weights-en-files",
        "weights-de-files"
      ],
      "produces": [
        "en-frontend-mlir",
        "en-encoder-mlir",
        "en-adapter-mlir",
        "en-prefill-mlir",
        "en-with-past-mlir",
        "en-dec-embed",
        "en-vocab",
        "de-frontend-mlir",
        "de-encoder-mlir",
        "de-adapter-mlir",
        "de-prefill-mlir",
        "de-with-past-mlir",
        "de-dec-embed",
        "de-vocab"
      ],
      "description": "Kotlin (MoonshineV2ExportCli): Hugging Face snapshot -> frontend, encoder, adapter, prefill, with_past StableHLO graphs (weights folded), dec_embed.bin, vocab.bin. Geometry and per-layer attention bands come from the checkpoint. Runs once per selected flavor.",
      "params": {
        "env": {
          "MOONSHINE_FE_SAMPLES": "21760",
          "MOONSHINE_ENC_FRAMES": "64",
          "MOONSHINE_MAX_MEM": "256"
        },
        "note": "The shapes are the runtime's compiled-in streaming geometry: 68 frontend frames (64 + 4 left context), a 64-frame encoder window, a 256-frame (5.12 s) padded decoder memory."
      }
    },
    {
      "id": "parameters",
      "kind": "convert",
      "tool": "iree-tools",
      "uses": [
        "en-prefill-mlir",
        "de-prefill-mlir"
      ],
      "produces": [
        "en-params-irpa",
        "de-params-irpa"
      ],
      "description": "iree-compile --iree-opt-export-parameters=model=params.irpa on the prefill graph: the decoder weights as one parameter archive, shared by prefill and step (byte-identical from either) and independent of the target. Runs once per selected flavor."
    },
    {
      "id": "compile",
      "kind": "compile",
      "tool": "iree-tools",
      "uses": [
        "en-frontend-mlir",
        "en-encoder-mlir",
        "en-adapter-mlir",
        "en-prefill-mlir",
        "en-with-past-mlir",
        "de-frontend-mlir",
        "de-encoder-mlir",
        "de-adapter-mlir",
        "de-prefill-mlir",
        "de-with-past-mlir"
      ],
      "produces": [
        "en-frontend-vmfb",
        "en-encoder-vmfb",
        "en-adapter-vmfb",
        "en-prefill-vmfb",
        "en-step-vmfb",
        "de-frontend-vmfb",
        "de-encoder-vmfb",
        "de-adapter-vmfb",
        "de-prefill-vmfb",
        "de-step-vmfb"
      ],
      "description": "StableHLO -> .vmfb for the target: frontend, encoder, adapter with weights embedded; prefill and step referencing the parameter archive under scope `model`. Runs once per selected flavor.",
      "per_target": true
    },
    {
      "id": "build-runtime",
      "kind": "build-runtime",
      "tool": "iree-android-runtime",
      "produces": [
        "runtime-so"
      ],
      "per_target": true,
      "description": "libskainet_moonshine_stream.so for the target ABI, taken from the released SKaiNET-transformers Android runtime AAR (built there from llm-runtime/iree-android/native)."
    },
    {
      "id": "pack",
      "kind": "pack",
      "tool": "blueprint-plugin",
      "description": "descriptor.json + manifest.json + artifacts/<role>/<language>/… (cartridge spec pack_dir).",
      "produces": [
        "pack-dir"
      ],
      "uses": [
        "runtime-so",
        "en-frontend-vmfb",
        "en-encoder-vmfb",
        "en-adapter-vmfb",
        "en-prefill-vmfb",
        "en-step-vmfb",
        "en-params-irpa",
        "en-dec-embed",
        "en-vocab",
        "de-frontend-vmfb",
        "de-encoder-vmfb",
        "de-adapter-vmfb",
        "de-prefill-vmfb",
        "de-step-vmfb",
        "de-params-irpa",
        "de-dec-embed",
        "de-vocab"
      ]
    },
    {
      "id": "sign",
      "kind": "sign",
      "tool": "blueprint-plugin",
      "description": "Ed25519 over the canonical manifest, key from the profile.",
      "produces": [
        "manifest"
      ],
      "uses": [
        "pack-dir"
      ]
    }
  ],
  "outputs": [
    {
      "from": "runtime-so",
      "role": "runtime",
      "path": "artifacts/runtime/libskainet_moonshine_stream.so",
      "derived_from": []
    },
    {
      "from": "en-frontend-vmfb",
      "role": "model",
      "path": "artifacts/model/en/frontend.vmfb",
      "derived_from": [

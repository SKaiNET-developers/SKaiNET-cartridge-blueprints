    },
    {
      "from": "de-step-vmfb",
      "role": "model",
      "path": "artifacts/model/de/step.vmfb",
      "derived_from": [
        "weights-de"
      ],
      "flavor": "de"
    },
    {
      "from": "de-params-irpa",
      "role": "weights",
      "path": "artifacts/weights/de/params.irpa",
      "derived_from": [
        "weights-de"
      ],
      "flavor": "de"
    },
    {
      "from": "de-dec-embed",

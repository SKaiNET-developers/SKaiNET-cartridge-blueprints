{
  "spec_version": "0.4",
  "kind": "blueprint",
  "id": "asr-moonshine-v2-streaming-iree",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Streaming speech-to-text: Moonshine v2 tiny (English, German) on IREE, Vulkan or CPU. Five self-compiled SKaiNET-DSL graphs driven by a streaming runtime: partial transcripts while you speak, an exact final at the end of the utterance.",
  "descriptor_template": {
    "family": "moonshine-v2-streaming",
    "execution_mode": "native",
    "model": {
      "name": "moonshine-streaming-tiny",
      "variant": "iree-fp32-streaming",
      "params": 27000000,
      "checkpoint": "moonshine-ai/moonshine-streaming-tiny",
      "upstream": {
        "source": "https://huggingface.co/moonshine-ai",
        "license": "MIT"
      }
    },
    "modality": "audio",
    "task": "asr",
    "io": {
      "mode": "streaming",
      "input": {
        "dtype": "float32-pcm",
        "shape": [
          null
        ],
        "sample_rate_hz": 16000,
        "chunk_ms": 80
      },
      "output": {
        "dtype": "utf8-text",
        "shape": [
          null
        ]
      }
    },
    "attributes": {
      "streaming": true,
      "languages": [],
      "state_model": "session",
      "partials": "cumulative, prefix-stable within an utterance; the final re-decodes exactly",
      "max_utterance_s": 5.12,
      "window_frames": 64,
      "hop_ms": 880,
      "weights": "fp32 (graphs and parameter archive)",
      "runtime_hint": {
        "runtime": "iree",
        "version": "3.11.0",
        "contract": "moonshine-v2-streaming-v1 (frontend + encoder + adapter + masked prefill + dynamic with_past, shared parameter archive, host-side embedding rows and detokenizer table)"
      }
    }
  },
  "sources": [
    {
      "name": "weights-en",
      "role": "weights",
      "uri": "hf://moonshine-ai/moonshine-streaming-tiny",
      "revision": "f8e9dfd8c562c257c151a907b7b7f2fe8ff8511a",

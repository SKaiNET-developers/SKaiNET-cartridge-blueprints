  ],
  "reference_measurements": [
    {
      "target": "vulkan-armv7",
      "flavor": "de",
      "measured_on": "arm32 Android device with a Mali GPU (Vulkan), IREE 3.11, 80 ms chunks",
      "performance": {
        "engine_init_s": 3.2,
        "first_partial_s": 0.79,
        "final_after_last_chunk_s": 0.87,
        "streaming_rtf": 1.33,
        "note": "an expectation for whoever materializes, never copied into a descriptor"
      }
    }
  ]
}

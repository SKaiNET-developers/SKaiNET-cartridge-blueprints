    },
    {
      "from": "de-adapter-vmfb",
      "role": "model",
      "path": "artifacts/model/de/adapter.vmfb",
      "derived_from": [
        "weights-de"
      ],
      "flavor": "de"
    },
    {
      "from": "de-prefill-vmfb",
      "role": "model",
      "path": "artifacts/model/de/prefill.vmfb",
